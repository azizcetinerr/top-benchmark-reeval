+    p = prob.squeeze(-1)                      # [B, L]  (squeeze() degil: B=1'de batch'i yutar)
+    new = masks | (p < threshold)
+
+    all_masked = new.all(dim=1)               # tamamen maskelenen satirlar
+    if all_masked.any():
+        # gercek (padding olmayan) token'lar arasindan en yuksek olasilikliyi ac
+        cand = p.masked_fill(masks, float('-inf'))
